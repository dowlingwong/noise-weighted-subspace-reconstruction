+    for stage, sub in (("validation_recombined_v2", "T22_validation_v2"),
+                       ("final_test_recombined_v2", "T22_final_test_v2")):
+        f = results / sub / "t22_recombine.json"
+        if f.is_file():
+            frozen["stage_output_sha256"][stage] = hashlib.sha256(f.read_bytes()).hexdigest()
+    return {
+        "per_file.csv": per_file,
+        "combined.csv": combined,
+        "rmse_by_method.csv": rmse,
+        "band_selection.csv": band,
+        "dependence.csv": dep,
+        "verdicts.json": json.dumps(verdicts, indent=2, sort_keys=True) + "\n",
+        "frozen.json": json.dumps(frozen, indent=2, sort_keys=True) + "\n",
+    }
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__,
+                                 formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--results", required=True,
+                    help="EXP results/t22_2026-09-11 directory")
+    ap.add_argument("--check", action="store_true", help="compare only; write nothing")
+    add_evidence_argument(ap)
+    args = ap.parse_args(argv)
+
+    target = evidence_root(args.evidence_root) / SUBDIR
+    produced = build(Path(args.results).expanduser().resolve())
+    status = 0
+    for name, text in produced.items():
+        dst = target / name
+        if dst.is_file() and dst.read_text(encoding="utf-8") == text:
+            print(f"[export-t22] unchanged {name}")
+            continue
+        if args.check:
+            print(f"[export-t22] DIFFERS {name}")
+            status = 1
+            continue
+        dst.parent.mkdir(parents=True, exist_ok=True)
+        dst.write_text(text, encoding="utf-8")
+        print(f"[export-t22] wrote {name} ({len(text)} bytes)")
+    return status
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
