+            # the first-order formula is about, and its worst case.
+            Eb = np.zeros((d, d)); Eb[k:, :k] = rng.normal(size=(d - k, k)); Eb = Eb + Eb.T
+            E = eps * Q @ (Eb / np.linalg.norm(Eb, 2)) @ Q.T
