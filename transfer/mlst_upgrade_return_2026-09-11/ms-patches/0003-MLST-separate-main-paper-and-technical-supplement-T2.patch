+        axf.scatter([i], [v], s=18, marker="o" if r["stage"] == "final-test" else "s",
+                    facecolor=c, edgecolor=hs.BORDER, linewidth=0.4, zorder=4)
+    c = comb["raw-bin|empca"]
+    axf.axhspan(float(c["ci_low"]) * sc, float(c["ci_high"]) * sc,
+                color=hs.lighten(hs.TEAL, 80), zorder=1)
+    axf.axhline(float(c["equal_file_mean"]) * sc, color=hs.TEAL, linewidth=0.9,
+                linestyle=(0, (3, 2)), zorder=2)
+    axf.set_xticks(range(len(rows)))
+    axf.set_xticklabels([f"{r['file']}  {float(r['f_inj_khz']):.0f}" for r in rows],
