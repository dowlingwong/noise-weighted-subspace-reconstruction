diff --git a/scripts/verify_evidence.py b/scripts/verify_evidence.py
new file mode 100755
index 0000000..ec87eac
--- /dev/null
+++ b/scripts/verify_evidence.py
@@ -0,0 +1,196 @@
+#!/usr/bin/env python3
+"""Verify the manuscript evidence root against ``evidence/MANIFEST.json``.
+
+Migrated on 11 September 2026 from ``transfer_paper/scripts/verify_bundle.py``,
+which was deleted together with the duplicated transfer bundle (MS ``bf7d5f6``).
+The checks are the same; only the manifest schema, the default root and the
+exclusion vocabulary changed.
+
+Checks, for one evidence root:
+  * every manifest entry names a file that exists, with matching SHA-256 and
+    byte count;
+  * no path is listed twice;
+  * (with ``--require-complete``) every file present under ``data/``,
+    ``figures/`` or ``tables/`` is listed, so that "manifest verifies" also
+    means "manifest is complete";
+  * paths recorded under ``excluded_retained_in_exp`` are neither present nor
+    listed, so a path that is absent here is either an error or an explicitly
+    recorded, hashed decision.
+
+With ``--compare OTHER`` it reports every path present in both roots whose
+bytes differ, split into "scientific" (``data/``, ``figures/``, ``tables/``)
+and "document" (everything else).  ``--compare`` accepts a second evidence root
+or a historical ``transfer_paper/`` bundle; a bundle's ``BUNDLE_MANIFEST.json``
+is read when ``MANIFEST.json`` is absent.
+
+Exit status is 0 only when no error was found.  This script never modifies
+anything.
+
+Usage::
+
+    python3 scripts/verify_evidence.py --require-complete
+    python3 scripts/verify_evidence.py --require-complete \
+        --compare <EXP>/transfer_paper --fail-on-scientific-diff
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from evidence_root import evidence_root, add_evidence_argument  # noqa: E402
+
+SCIENTIFIC_PREFIXES = ("data/", "figures/", "tables/", "notebooks/")
+SKIP_NAMES = {".DS_Store", "MANIFEST.json", "BUNDLE_MANIFEST.json",
+              "PROVENANCE.md", "README.md"}
+
+
+def sha256_of(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for block in iter(lambda: handle.read(1 << 20), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def load_manifest(root: Path) -> tuple[dict, set[str]]:
+    """Return (manifest, excluded-paths).  Accepts both manifest schemas."""
+    new, old = root / "MANIFEST.json", root / "BUNDLE_MANIFEST.json"
+    if new.is_file():
+        manifest = json.loads(new.read_text(encoding="utf-8"))
+        excluded = set(manifest.get("excluded_retained_in_exp", {}))
+    elif old.is_file():
+        manifest = json.loads(old.read_text(encoding="utf-8"))
+        unavailable = manifest.get("excluded_unavailable")
+        excluded = set(unavailable) if isinstance(unavailable, dict) else set()
+    else:
+        raise SystemExit(f"no MANIFEST.json or BUNDLE_MANIFEST.json under {root}")
+    return manifest, excluded
+
+
+def verify(root: Path, require_complete: bool) -> tuple[list[str], list[str], dict[str, str]]:
+    errors: list[str] = []
+    notes: list[str] = []
+    manifest, excluded = load_manifest(root)
+    entries = manifest["files"]
+    seen: dict[str, str] = {}
+    for entry in entries:
+        rel = entry["path"]
+        if rel in seen:
+            errors.append(f"duplicate manifest path: {rel}")
+            continue
+        seen[rel] = entry["sha256"]
+        target = root / rel
+        if not target.is_file():
+            errors.append(f"missing file: {rel}")
+            continue
+        size = target.stat().st_size
+        if size != entry.get("bytes"):
+            errors.append(f"byte-count mismatch: {rel} manifest={entry.get('bytes')} disk={size}")
+        if sha256_of(target) != entry["sha256"]:
+            errors.append(f"sha256 mismatch: {rel}")
+    for rel in sorted(excluded):
+        if (root / rel).is_file():
+            errors.append(f"path recorded as excluded but present: {rel}")
+        if rel in seen:
+            errors.append(f"path both listed and recorded as excluded: {rel}")
+    if require_complete:
+        listed = set(seen)
+        for prefix in ("data", "figures", "tables"):
+            base = root / prefix
+            if not base.is_dir():
+                continue
+            for path in base.rglob("*"):
+                if not path.is_file() or "__pycache__" in path.parts:
+                    continue
+                if path.name in SKIP_NAMES:
+                    continue
+                rel = path.relative_to(root).as_posix()
+                if rel not in listed and rel not in excluded:
+                    errors.append(f"unlisted file under {prefix}/: {rel}")
+    notes.append(f"{root}: {len(entries)} manifest entries, {len(excluded)} recorded excluded")
+    return errors, notes, seen
+
+
+def compare(a: Path, b: Path, sha_a: dict[str, str], sha_b: dict[str, str]) -> list[str]:
+    lines: list[str] = []
+    common = sorted(set(sha_a) & set(sha_b))
+    sci, doc = [], []
+    for rel in common:
+        if sha_a[rel] != sha_b[rel]:
+            (sci if rel.startswith(SCIENTIFIC_PREFIXES) else doc).append(rel)
+    only_a = sorted(set(sha_a) - set(sha_b))
+    only_b = sorted(set(sha_b) - set(sha_a))
+    lines.append(f"paths in both roots: {len(common)}; only in {a}: {len(only_a)}; "
+                 f"only in {b}: {len(only_b)}")
+    lines.append(f"scientific files differing across roots: {len(sci)}")
+    lines.extend(f"  DIFF(scientific) {rel}" for rel in sci)
+    lines.append(f"document files differing across roots: {len(doc)}")
+    lines.extend(f"  diff(document) {rel}" for rel in doc)
+    lines.extend(f"  only-in-{a.name}: {rel}" for rel in only_a[:50])
+    lines.extend(f"  only-in-{b.name}: {rel}" for rel in only_b[:50])
+    return lines
+
+
+def main(argv=None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__,
+                                     formatter_class=argparse.RawDescriptionHelpFormatter)
+    add_evidence_argument(parser)
+    parser.add_argument("--compare", default=None,
+                        help="second evidence root or transfer_paper bundle")
+    parser.add_argument("--require-complete", action="store_true",
+                        help="fail if a file under data/, figures/ or tables/ is not listed")
+    parser.add_argument("--fail-on-scientific-diff", action="store_true",
+                        help="with --compare: exit non-zero if any data/figures/tables file differs")
+    parser.add_argument("--require-shared", nargs="*", default=None,
+                        help="with --compare: prefixes under which every path listed in either "
+                             "root must be listed in both")
+    args = parser.parse_args(argv)
+
+    root = evidence_root(args.evidence_root)
+    if not root.is_dir():
+        raise SystemExit(f"evidence root not found: {root}\n"
+                         f"materialize it first: "
+                         f"python3 scripts/materialize_evidence.py --from-git c826ef6")
+    errors, notes, sha_a = verify(root, args.require_complete)
+    print("\n".join(notes))
+    status = 0
+    if errors:
+        status = 1
+        print(f"ERRORS in {root}: {len(errors)}")
+        print("\n".join("  " + e for e in errors))
+    else:
+        print(f"OK: {root} verifies")
+    if args.compare:
+        other = Path(args.compare).expanduser().resolve()
+        errors_b, notes_b, sha_b = verify(other, args.require_complete)
+        print("\n".join(notes_b))
+        if errors_b:
+            status = 1
+            print(f"ERRORS in {other}: {len(errors_b)}")
+            print("\n".join("  " + e for e in errors_b))
+        else:
+            print(f"OK: {other} verifies")
+        lines = compare(root, other, sha_a, sha_b)
+        print("\n".join(lines))
+        if args.fail_on_scientific_diff and any(l.startswith("  DIFF(scientific)") for l in lines):
+            status = 1
+        if args.require_shared is not None:
+            prefixes = tuple(args.require_shared) or SCIENTIFIC_PREFIXES
+            missing_b = sorted(p for p in sha_a if p.startswith(prefixes) and p not in sha_b)
+            missing_a = sorted(p for p in sha_b if p.startswith(prefixes) and p not in sha_a)
+            for p in missing_b:
+                print(f"  MISSING in {other}: {p}")
+            for p in missing_a:
+                print(f"  MISSING in {root}: {p}")
+            status = 1 if (missing_a or missing_b) else status
+            if not (missing_a or missing_b):
+                print(f"shared coverage OK under {', '.join(prefixes)}")
+    return status
+
+
+if __name__ == "__main__":
+    sys.exit(main())
