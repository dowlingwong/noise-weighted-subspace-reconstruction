diff --git a/scripts/recompute_t22.py b/scripts/recompute_t22.py
new file mode 100755
index 0000000..b83641b
--- /dev/null
+++ b/scripts/recompute_t22.py
@@ -0,0 +1,135 @@
+#!/usr/bin/env python3
+"""Independently recompute the T22 headline numbers from the archived arrays.
+
+This re-implements the declared combination from scratch -- the two-stage
+percentile bootstrap, the continuity-corrected two-sided p, Holm's step-down
+and the verdict rule -- and reads only the archived per-file bootstrap draw
+arrays and the frozen configuration.  It never reads the runner's own combined
+block or the report prose, so a disagreement means the reported numbers are
+wrong.
+
+Usage::
+
+    python3 scripts/recompute_t22.py --results <EXP>/results/t22_2026-09-11
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+import numpy as np
+
+CLAIMS = {"limited_recovery": ("zero|empca", "calibration-mean|empca"),
+          "denoising_benefit": ("raw-bin|empca",),
+          "metric_contribution": ("pca|empca",)}
+
+
+def verified(stage_dir: Path, name: str) -> bytes:
+    raw = (stage_dir / name).read_bytes()
+    listed = {l.split()[1].lstrip("*"): l.split()[0]
+              for l in (stage_dir / "RESULTS_SHA256").read_text().split("\n") if l.strip()}
+    if listed.get(name) != hashlib.sha256(raw).hexdigest():
+        raise SystemExit(f"sha256 mismatch for {stage_dir / name}")
+    return raw
+
+
+def stable_offset(key: str) -> int:
+    import zlib
+    return int(zlib.crc32(key.encode())) % 100_000
+
+
+def two_stage(draws: list[np.ndarray], replicates: int, seed: int) -> dict:
+    rng = np.random.default_rng(seed)
+    n = len(draws)
+    means = np.empty(replicates)
+    for j in range(replicates):
+        idx = rng.integers(0, n, size=n)
+        means[j] = float(np.mean([draws[i][rng.integers(0, draws[i].size)] for i in idx]))
+    lo, hi = np.percentile(means, [2.5, 97.5])
+    le, ge = float(np.sum(means <= 0.0)), float(np.sum(means >= 0.0))
+    p = min(1.0, 2.0 * min((le + 1) / (replicates + 1), (ge + 1) / (replicates + 1)))
+    return {"ci95_lo": float(lo), "ci95_hi": float(hi), "p": float(p),
+            "excludes_zero": bool(lo > 0 or hi < 0)}
+
+
+def holm(pvals: dict) -> dict:
+    items = sorted(pvals.items(), key=lambda kv: kv[1])
+    out, running = {}, 0.0
+    for i, (name, p) in enumerate(items):
+        running = min(1.0, max(running, (len(items) - i) * p))
+        out[name] = running
+    return out
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__,
+                                 formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--results", required=True)
+    args = ap.parse_args(argv)
+    R = Path(args.results).expanduser().resolve()
+
+    frozen = json.loads(verified(R / "T22_freeze_v1", "t22_freeze.json"))["frozen"]
+    ft = json.loads(verified(R / "T22_final_test_v1", "t22_final-test.json"))["final-test"]
+    npz_path = R / "T22_final_test_v1" / "t22_final-test_draws.npz"
+    listed = {l.split()[1].lstrip("*"): l.split()[0]
+              for l in (R / "T22_final_test_v1" / "RESULTS_SHA256").read_text().split("\n") if l.strip()}
+    if listed.get(npz_path.name) != hashlib.sha256(npz_path.read_bytes()).hexdigest():
+        raise SystemExit(f"sha256 mismatch for {npz_path}")
+    draws = np.load(npz_path)
+
+    entering = [f for f, r in sorted(ft["per_file"].items()) if r.get("in_combined_estimate")]
+    dep = frozen["dependence_verdict"]
+    reps, seed0 = int(frozen["file_level_replicates"]), int(frozen["file_level_seed"])
+    print(f"frozen band B = {frozen['selected_band']}, b_eval = {frozen['block_length_evaluation']}, "
+          f"b_cal = {frozen['block_length_calibration']}, dependence = {dep}")
+    print(f"files entering the combined estimate: {[f[-7:-3] for f in entering]}\n")
+
+    results, pvals = {}, {}
+    for key in sorted({k for ks in CLAIMS.values() for k in ks}):
+        arrays = [np.asarray(draws[f"{f}|{key}"]) for f in entering]
+        point = float(np.mean([float(np.mean(a)) for a in arrays]))
+        r = two_stage(arrays, reps, seed0 + stable_offset(key))
+        results[key] = {**r, "point_of_bootstrap_means": point,
+                        "point_of_estimates": float(np.mean(
+                            [ft["per_file"][f]["contrasts"][key]["mean_delta_squared"]
+                             for f in entering]))}
+        ref = ft["combined"][key]["primary_equal_file"]
+        agree = (abs(r["ci95_lo"] - ref["ci95_lo"]) < 1e-12
+                 and abs(r["ci95_hi"] - ref["ci95_hi"]) < 1e-12
+                 and abs(r["p"] - ref["p_two_sided"]) < 1e-12)
+        print(f"{key:24s} equal-file {results[key]['point_of_estimates']:+.6g}  "
+              f"CI[{r['ci95_lo']:+.5g},{r['ci95_hi']:+.5g}]  p={r['p']:.5g}   "
+              f"reproduces archive: {'YES' if agree else 'NO'}")
+
+    for claim, keys in CLAIMS.items():
+        pvals[claim] = max(results[k]["p"] for k in keys)
+    adj = holm(pvals)
+    print()
+    ok = True
+    for claim, keys in CLAIMS.items():
+        favours = all(results[k]["point_of_estimates"] > 0 for k in keys)
+        excl = all(results[k]["excludes_zero"] for k in keys)
+        if dep == "inconclusive":
+            verdict = "inconclusive"
+        elif favours and excl and adj[claim] < 0.05:
+            verdict = "supported"
+        elif favours:
+            verdict = "ordering-only"
+        else:
+            verdict = "not-supported"
+        archived = ft["verdicts"][claim]["verdict"]
+        same = verdict == archived
+        ok &= same
+        print(f"{claim:22s} recomputed={verdict:14s} archived={archived:14s} "
+              f"p_holm={adj[claim]:.5g} (archived {ft['verdicts'][claim]['p_holm_adjusted']:.5g})  "
+              f"{'MATCH' if same else 'MISMATCH'}")
+        print(f"{'':22s}   would-have-been without the dependence rule: "
+              f"{'supported' if (favours and excl and adj[claim] < 0.05) else ('ordering-only' if favours else 'not-supported')}")
+    print("\nAll verdicts reproduce." if ok else "\nVERDICT MISMATCH")
+    return 0 if ok else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
