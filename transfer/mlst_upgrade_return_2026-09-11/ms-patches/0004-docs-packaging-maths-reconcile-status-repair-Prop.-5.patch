+        if overlap > cap + 1e-8:
+            signs_ok = False
+        lower = gap * (k - overlap)
+        actual = RK(Pf) - RK(Pu)
+        if lower > 0:
+            worst_bound = max(worst_bound, lower / max(actual, 1e-300))
+    check("Prop. 6.3: the risk decomposition is an algebraic identity for any fitted pair",
+          worst_identity < 1e-10, f"worst relative residual {worst_identity:.2e}")
+    check("Prop. 6.3: a >= 0 and x_U >= 0, and tr(P_F P*_U) respects the partial-trace cap",
+          signs_ok, "200 random instances, C=4, T=5, (k_c,k_t)=(2,2)")
+    check("Prop. 6.3: the Delta_k (k - tr(P_F P*_U)) lower bound never exceeds the actual cost",
+          worst_bound <= 1.0 + 1e-9, f"worst bound/actual {worst_bound:.4f}")
+
