+#     with ||M|| <= eps*lambda_1, i.e. O(eps^2 lambda_1^2 / delta^2), and since
+#     delta <= lambda_k <= lambda_1 that dominates.  This check exhibits the
+#     violation of the old order on a coupling-block perturbation and confirms
+#     the corrected one.
+def local_displacement_remainder_check() -> None:
+    rng = np.random.default_rng(11)
