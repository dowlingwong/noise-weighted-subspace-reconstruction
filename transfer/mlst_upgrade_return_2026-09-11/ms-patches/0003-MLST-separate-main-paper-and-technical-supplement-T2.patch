+
+def verified(stage_dir: Path, name: str) -> dict:
+    target, manifest = stage_dir / name, stage_dir / "RESULTS_SHA256"
+    if not target.is_file():
+        raise SystemExit(f"missing stage output: {target}")
+    raw = target.read_bytes()
+    listed = {l.split()[1].lstrip("*"): l.split()[0]
+              for l in manifest.read_text().split("\n") if l.strip()}
+    want = listed.get(name)
+    if want is None:
+        raise SystemExit(f"{name} is not listed in {manifest}")
+    got = hashlib.sha256(raw).hexdigest()
+    if want != got:
+        raise SystemExit(f"sha256 mismatch for {target}: archive {want}, file {got}")
+    return json.loads(raw)
+
+
