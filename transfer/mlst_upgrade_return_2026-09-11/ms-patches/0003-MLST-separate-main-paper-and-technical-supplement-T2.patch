+%% ============================================================
+%% MLST technical supplement.  Build:  latexmk -pdf supplement_mlst.tex
+%% Companion to main_mlst.tex; the main paper cites sections here as
+%% "Supplement, Section Sn".  The extended arXiv preprint (main.tex) carries
+%% the same material as Appendices A-I and is a separate deliverable.
+%% ============================================================
+\documentclass[12pt]{article}
+\usepackage[margin=1.1in]{geometry}
+\linespread{1.15}
+\usepackage{amsmath, amssymb, amsthm}
+\usepackage{graphicx}
+\usepackage{booktabs}
+\usepackage{hyperref}
+\usepackage{xcolor}
+\usepackage{cleveref}
+\usepackage{longtable}
+\usepackage{array}
+\usepackage{multirow}
+\usepackage[section]{placeins}
+\usepackage{tikz}
+\usepackage[numbers,sort&compress]{natbib}
+%% Import the main paper's labels so shared appendix sources cross-reference
+%% real numbers.  Build main_mlst.tex first, in the same directory; if its .aux
+%% is absent the references degrade to '??' and nothing else breaks.
+\usepackage{xr}
+\externaldocument{main_mlst}
+\usetikzlibrary{positioning,arrows.meta}
+\hypersetup{hypertexnames=false}
+\setlength{\emergencystretch}{3em}
+
+\providecommand{\R}{\mathbb{R}}
+\providecommand{\C}{\mathbb{C}}
+\providecommand{\tr}{\operatorname{tr}}
+\providecommand{\range}{\operatorname{range}}
+\providecommand{\vecop}{\operatorname{vec}}
+\providecommand{\Sn}{\Sigma}
+
+%% Same gate as the main paper; the default build never sets this true.
+\newif\ifgatedevidence
+\gatedevidencefalse
+\newcommand{\sepevidenceref}{\ifgatedevidence Section~\ref{subsec:separable-evidence}\else the controlled separable-class evidence, held from this version\fi}
+
+\newtheorem{theorem}{Theorem}[section]
+\newtheorem{proposition}[theorem]{Proposition}
+\newtheorem{corollary}[theorem]{Corollary}
+\newtheorem{lemma}[theorem]{Lemma}
+\newtheorem{definition}{Definition}[section]
+\newtheorem{remark}{Remark}[section]
+\newtheorem{example}[theorem]{Example}
+
+\renewcommand{\thesection}{S\arabic{section}}
+\renewcommand{\theequation}{S\arabic{equation}}
+\renewcommand{\thetable}{S\arabic{table}}
+\renewcommand{\thefigure}{S\arabic{figure}}
+
+\title{Technical supplement to\\
+\emph{Noise Covariance Defines Reconstruction Geometry:\\
+Optimal Filtering, Weighted Subspaces, and Tied Linear Autoencoders}}
+\author{Dowling Wong\\
+  \small Department of Physics, Karlsruhe Institute of Technology\\
