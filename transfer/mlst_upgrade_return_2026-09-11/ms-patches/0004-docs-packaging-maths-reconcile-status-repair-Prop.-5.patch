+    old_violated, new_ok, worst_new = False, True, 0.0
+    for delta in (1.0, 0.2, 0.05, 0.01, 0.005):
+        lam = np.concatenate([np.ones(k), np.full(d - k, 1.0 - delta)]) - 0.001 * np.arange(d)
