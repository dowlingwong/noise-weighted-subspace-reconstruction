+#     the stated sign, and the restriction-cost lower bound holds with its Ky Fan
+#     partial-trace form.
+def risk_decomposition_check() -> None:
+    rng = np.random.default_rng(23)
+    C, T, kc, kt = 4, 5, 2, 2
+    d, k = C * T, kc * kt
+    worst_bound, worst_identity, signs_ok = 0.0, 0.0, True
+    for _ in range(200):
+        B = rng.normal(size=(d, d)); K = B @ B.T
+        mu, V = np.linalg.eigh(K); mu, V = mu[::-1], V[:, ::-1]
+        Pu = V[:, :k] @ V[:, :k].T
+        gap = mu[k - 1] - mu[k]
+        RK = lambda P: float(np.trace(K) - np.trace(P @ K))
+        # a product projector: random factor subspaces
+        Qc, _ = np.linalg.qr(rng.normal(size=(C, C))); Qt, _ = np.linalg.qr(rng.normal(size=(T, T)))
+        Pc = Qc[:, :kc] @ Qc[:, :kc].T; Pt = Qt[:, :kt] @ Qt[:, :kt].T
+        Pf = np.kron(Pt, Pc)          # vec order (t outer, c inner), as in the text
+        # (1) the decomposition is an identity for ANY fitted pair
+        Qf, _ = np.linalg.qr(rng.normal(size=(C, C))); Qg, _ = np.linalg.qr(rng.normal(size=(T, T)))
+        Phf = np.kron(Qg[:, :kt] @ Qg[:, :kt].T, Qf[:, :kc] @ Qf[:, :kc].T)
+        Qu, _ = np.linalg.qr(rng.normal(size=(d, k))); Phu = Qu @ Qu.T
+        lhs = RK(Phf) - RK(Phu)
+        rhs = (RK(Pf) - RK(Pu)) + (RK(Phf) - RK(Pf)) - (RK(Phu) - RK(Pu))
+        worst_identity = max(worst_identity, abs(lhs - rhs) / max(1.0, abs(lhs)))
+        # (2) signs: a >= 0 against the unrestricted optimum, x_U >= 0
+        if RK(Pf) - RK(Pu) < -1e-8 or RK(Phu) - RK(Pu) < -1e-8:
+            signs_ok = False
+        # (3) the lower bound and its partial-trace cap
+        Mc = np.einsum("iajb->ab", Pu.reshape(T, C, T, C))   # trace over the temporal factor
+        Mt = np.einsum("aibj->ab", Pu.reshape(T, C, T, C))   # trace over the channel factor
+        cap = min(k, float(np.sort(np.linalg.eigvalsh(Mc))[::-1][:kc].sum()),
+                  float(np.sort(np.linalg.eigvalsh(Mt))[::-1][:kt].sum()))
