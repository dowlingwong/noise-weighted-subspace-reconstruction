diff --git a/scripts/evidence_root.py b/scripts/evidence_root.py
new file mode 100644
index 0000000..b4b0b8c
--- /dev/null
+++ b/scripts/evidence_root.py
@@ -0,0 +1,53 @@
+"""Resolve the canonical manuscript evidence root.
+
+One rule, used by every manuscript-side tool (claim validator, figure
+generators, revision checker, packaging, manifest verifier):
+
+1. ``--evidence-root`` on the command line, when the tool offers it;
+2. the ``PAPER1_EVIDENCE_ROOT`` environment variable;
+3. ``<repository>/evidence`` -- the tracked default.
+
+No absolute path is ever written into tracked source.  The repository root is
+found from this file's location, so a copied or renamed checkout still works.
+
+History: until 11 September 2026 the manuscript read its evidence from
+``transfer_paper/``, a bundle duplicated byte-for-byte in the experiment
+repository.  MS ``bf7d5f6`` removed that duplicate.  ``evidence/`` replaces it
+as the single manuscript-side source; ``scripts/materialize_evidence.py``
+rebuilds it from the experiment repository, and
+``scripts/verify_evidence.py`` checks it against ``evidence/MANIFEST.json``.
+"""
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+DEFAULT_EVIDENCE_DIRNAME = "evidence"
+ENV_VAR = "PAPER1_EVIDENCE_ROOT"
+
+
+def evidence_root(explicit: str | os.PathLike | None = None) -> Path:
+    """Return the evidence root without requiring that it exists."""
+    if explicit:
+        return Path(explicit).expanduser().resolve()
+    env = os.environ.get(ENV_VAR)
+    if env:
+        return Path(env).expanduser().resolve()
+    return REPO_ROOT / DEFAULT_EVIDENCE_DIRNAME
+
+
+def require_evidence_root(explicit: str | os.PathLike | None = None) -> Path:
+    root = evidence_root(explicit)
+    if not root.is_dir():
+        raise SystemExit(
+            f"evidence root not found: {root}\n"
+            f"Set {ENV_VAR}, pass --evidence-root, or materialize it with\n"
+            f"  python3 scripts/materialize_evidence.py --from-git c826ef6")
+    return root
+
+
+def add_evidence_argument(parser) -> None:
+    parser.add_argument("--evidence-root", default=None,
+                        help=f"manuscript evidence root (default: ${ENV_VAR} "
+                             f"or <repo>/{DEFAULT_EVIDENCE_DIRNAME})")
diff --git a/scripts/export_tidmad_heldout.py b/scripts/export_tidmad_heldout.py
new file mode 100755
index 0000000..2197c99
--- /dev/null
+++ b/scripts/export_tidmad_heldout.py
@@ -0,0 +1,175 @@
+#!/usr/bin/env python3
+"""Export the T10--T12 TIDMAD held-out inputs of Fig. 10 from the run archive.
+
+Until 11 September 2026 the three CSV inputs of ``fig_tidmad_perfile.pdf`` were
+*transcribed* from the printed tables of
+``reviews/2026-09-10-experiment-phase-report.md`` (two significant figures,
+some interval endpoints blank), because the run archive had been produced on
+the execution host and was not available where the figure was built.  This
+script replaces that transcription: it reads the archived stage JSONs directly
+and writes the same three files at full double precision, adding the per-file
+bootstrap standard deviations that the transcription could only approximate
+from rounded interval endpoints.
+
+Nothing here re-runs an experiment or changes an estimand.  Every value is read
+from a stage output whose ``RESULTS_SHA256`` is verified first; the primary
+combined estimate and its interval are the archived ones.
+
+Usage::
+
+    python3 scripts/export_tidmad_heldout.py \
+        --results <EXP>/results/mlst_2026-09-10 [--evidence-root <dir>] [--check]
+"""
+from __future__ import annotations
+
+import argparse
+import csv
+import hashlib
+import io
+import json
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from evidence_root import evidence_root, add_evidence_argument  # noqa: E402
+
+SUBDIR = Path("data") / "paper1" / "mlst_2026-09-11"
+#: Contrasts written to the combined CSV, with the labels the figure uses.
+COMBINED_ROWS = (("zero|empca", "zero - EMPCA"),
+                 ("calibration-mean|empca", "cal-mean - EMPCA"),
+                 ("pca|empca", "PCA - EMPCA"),
+                 ("raw-bin|empca", "bin read - EMPCA"),
+                 ("zero|raw-bin", "zero - bin read"))
+#: Method order and display names of the RMSE panel.
+RMSE_METHODS = (("zero", "zero"), ("calibration-mean", "cal. mean"),
+                ("pca", "PCA"), ("empca", "EMPCA"), ("raw-bin", "bin read"),
+                ("quadrature-OF", "quad. OF"), ("wiener", "Wiener"),
+                ("shrinkage-cal", "shrink. cal."))
+OUTCOME_LABEL = {"eligible-coupled": "eligible", "uncoupled": "uncoupled",
+                 "multi-tone": "multi-tone", "chirped": "chirped",
+                 "underpowered": "underpowered"}
+
+
+def verified_json(stage_dir: Path, name: str) -> dict:
+    """Read one stage output after checking it against its RESULTS_SHA256."""
+    target = stage_dir / name
+    manifest = stage_dir / "RESULTS_SHA256"
+    if not target.is_file():
+        raise SystemExit(f"missing stage output: {target}")
+    raw = target.read_bytes()
+    digest = hashlib.sha256(raw).hexdigest()
+    if manifest.is_file():
+        listed = {line.split()[1].lstrip("*"): line.split()[0]
+                  for line in manifest.read_text().split("\n") if line.strip()}
+        want = listed.get(name)
+        if want is None:
+            raise SystemExit(f"{name} is not listed in {manifest}")
+        if want != digest:
+            raise SystemExit(f"sha256 mismatch for {target}: archive says {want}, file is {digest}")
+    else:
+        raise SystemExit(f"missing checksum manifest: {manifest}")
+    return json.loads(raw)
+
+
+def short(name: str) -> str:
+    """``abra_validation_0012.h5`` -> ``0012``."""
+    return name.replace("abra_validation_", "").replace(".h5", "")
+
+
+def csv_text(header: list[str], rows: list[list]) -> str:
+    buf = io.StringIO()
+    w = csv.writer(buf, lineterminator="\n")
+    w.writerow(header)
+    w.writerows(rows)
+    return buf.getvalue()
+
+
+def build(results: Path) -> dict[str, str]:
+    final = verified_json(results / "T10_tidmad_final_test_v1", "t10_final-test.json")["final-test"]
+    valid = verified_json(results / "T10_tidmad_validation_v1", "t10_validation.json")["validation"]
+
+    # --- per-file rows (final test, the executed-once held-out stage) --------
+    per = sorted(final["per_file"].values(),
+                 key=lambda r: r["characterisation"]["f_inj_hz"])
+    combined_files = [r for r in per if r.get("in_combined_estimate")]
+    inv = [1.0 / r["contrasts"]["zero|empca"]["bootstrap_sd"] ** 2 for r in combined_files]
+    total_w = sum(inv)
+    share = {r["file"]: 100.0 * v / total_w for r, v in zip(combined_files, inv)}
+
+    rows = []
+    for r in per:
+        z = r["contrasts"]["zero|empca"]
+        c = r["contrasts"]["calibration-mean|empca"]
+        rows.append([
+            short(r["file"]),
+            f"{r['characterisation']['f_inj_hz'] / 1e3:.6f}",
+            OUTCOME_LABEL.get(r["characterisation"]["outcome"], r["characterisation"]["outcome"]),
+            repr(z["mean_delta_squared"]), repr(z["ci95_lo"]), repr(z["ci95_hi"]),
+            int(bool(z["ci_excludes_zero"])),
+            repr(c["mean_delta_squared"]), int(bool(c["ci_excludes_zero"])),
+            (f"{share[r['file']]:.10g}" if r["file"] in share else ""),
+            repr(z["bootstrap_sd"]), repr(c["bootstrap_sd"]),
+            int(bool(r.get("in_combined_estimate"))),
+        ])
+    per_csv = csv_text(
+        ["file", "f_inj_khz", "outcome", "delta_zero_empca", "ci_low", "ci_high",
+         "ci_excludes_zero", "delta_calmean_empca", "calmean_excludes_zero",
+         "weight_share_pct", "bootstrap_sd_zero_empca", "bootstrap_sd_calmean_empca",
+         "in_combined_estimate"], rows)
+
+    # --- combined estimate (archived, unchanged) ----------------------------
+    crows = []
+    for key, label in COMBINED_ROWS:
+        c = final["combined"][key]
+        lo, hi = c["theta_iv_ci95"]
+        crows.append([label, repr(c["theta_iv_precision_weighted"]), repr(lo), repr(hi),
+                      repr(c["unweighted_mean"]), repr(c["cochran_Q"]), c["Q_dof"],
+                      repr(c["I_squared"]), c["n_files"]])
+    comb_csv = csv_text(["contrast", "theta_iv", "ci_low", "ci_high", "unweighted",
+                         "cochran_Q", "Q_dof", "I_squared", "n_files"], crows)
+
+    # --- RMSE by method over the 11 eligible-coupled stretches ---------------
+    eligible = [r for src in (valid["per_file"], final["per_file"]) for r in src.values()
+                if r["characterisation"]["outcome"] == "eligible-coupled"]
+    mrows = []
+    for key, label in RMSE_METHODS:
+        vals = [r["rmse_by_method_amplitude_units"][key] for r in eligible]
+        mrows.append([label, repr(sum(vals) / len(vals)), len(vals)])
+    rmse_csv = csv_text(["method", "mean_rmse", "n_stretches"], mrows)
+
+    return {"tidmad_heldout_perfile_2026-09-10.csv": per_csv,
+            "tidmad_heldout_combined_2026-09-10.csv": comb_csv,
+            "tidmad_heldout_rmse_by_method_2026-09-10.csv": rmse_csv}
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__,
+                                 formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--results", required=True,
+                    help="EXP results/mlst_2026-09-10 directory (the T10-T12 archive)")
+    ap.add_argument("--check", action="store_true", help="compare only; write nothing")
+    add_evidence_argument(ap)
+    args = ap.parse_args(argv)
+
+    results = Path(args.results).expanduser().resolve()
+    target = evidence_root(args.evidence_root) / SUBDIR
+    produced = build(results)
+    status = 0
+    for name, text in produced.items():
+        dst = target / name
+        old = dst.read_text(encoding="utf-8") if dst.is_file() else None
+        if old == text:
+            print(f"[export] unchanged {name}")
+            continue
+        if args.check:
+            print(f"[export --check] DIFFERS {name}")
+            status = 1
+            continue
+        dst.parent.mkdir(parents=True, exist_ok=True)
+        dst.write_text(text, encoding="utf-8")
+        print(f"[export] wrote {name} ({len(text)} bytes)")
+    return status
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/materialize_evidence.py b/scripts/materialize_evidence.py
new file mode 100755
index 0000000..f590cde
--- /dev/null
+++ b/scripts/materialize_evidence.py
@@ -0,0 +1,257 @@
+#!/usr/bin/env python3
+"""Build (or check) the manuscript evidence root from a source bundle.
+
+The manuscript needs a small, versioned set of archived result files and
+figures.  The experiment repository is the source of record for the runs
+themselves; this script exports the manuscript-facing subset into
+``evidence/`` and writes ``evidence/MANIFEST.json`` so that a clean checkout
+can rebuild every figure and re-read every claimed number without touching the
+raw-data filesystem.
+
+Sources
+-------
+``--source DIR``      a directory laid out like the historical
+                      ``transfer_paper/`` bundle (``data/``, ``figures/``,
+                      ``tables/``), e.g. ``<EXP>/transfer_paper``.
+``--from-git REV``    the same tree taken from this repository's own history,
+                      e.g. ``--from-git c826ef6`` (the commit before the
+                      duplicate bundle was removed).
+
+Policy
+------
+Everything under ``data/`` is exported except the paths in ``EXCLUDE``; under
+``figures/`` only the vector (``.pdf``) figures are exported, because the
+manuscript includes those and the bitmap copies were preview artefacts; all of
+``tables/`` is exported.  Every excluded path is still recorded, with its
+SHA-256 and byte count, in the manifest's ``excluded_retained_in_exp`` block,
+so "missing from evidence/" is always an explicit, checkable decision rather
+than an accident.
+
+Usage
+-----
+    python3 scripts/materialize_evidence.py --from-git c826ef6
+    python3 scripts/materialize_evidence.py --source ../exp/transfer_paper --check
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import shutil
+import subprocess
+import sys
+import tarfile
+import tempfile
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from evidence_root import REPO_ROOT, evidence_root, add_evidence_argument  # noqa: E402
+
+#: Trees copied verbatim from the source bundle.
+INCLUDE_TREES = ("data", "figures", "tables")
+
+#: Path prefixes (relative to the source bundle) that stay in the experiment
+#: repository only.  Each one is recorded in the manifest with its hash.
+EXCLUDE_PREFIXES = (
+    # Three superseded GWOSC run directories.  ``data/gwosc/current/`` is the
+    # registered run (20260622T175125Z_b169c1f595a4) and is exported; the two
+    # earlier runs and the third copy are provenance-only.
+    "data/gwosc/runs/",
+)
+
+#: Suffix filter applied per tree.  ``None`` means "every file".
+TREE_SUFFIX_FILTER = {
+    "data": None,
+    # The manuscript includes vector figures; the ``.png`` twins existed for
+    # the notebook previews that are not part of this export.
+    "figures": (".pdf", ".tex", ".md"),
+    "tables": None,
+}
+
+#: Single documents carried over from the bundle root (cited by the LaTeX).
+INCLUDE_FILES = ("MANUSCRIPT_EVIDENCE_MAP.md",)
+
+#: Paths whose canonical producer is another manuscript script rather than the
+#: historical bundle.  They are hashed into the manifest like everything else,
+#: but they are never overwritten from ``--source``/``--from-git``: the named
+#: producer owns them.  (Before 11 September 2026 the three TIDMAD CSVs were
+#: transcribed by hand from the phase report; they are now exported at full
+#: precision from the run archive.)
+REGENERATED = {
+    "data/paper1/mlst_2026-09-11/tidmad_heldout_perfile_2026-09-10.csv":
+        "scripts/export_tidmad_heldout.py",
+    "data/paper1/mlst_2026-09-11/tidmad_heldout_combined_2026-09-10.csv":
+        "scripts/export_tidmad_heldout.py",
+    "data/paper1/mlst_2026-09-11/tidmad_heldout_rmse_by_method_2026-09-10.csv":
+        "scripts/export_tidmad_heldout.py",
+    "data/paper1/mlst_2026-09-11/README.md": "hand-maintained provenance note",
+}
+
+SCIENTIFIC_PREFIXES = ("data/", "figures/", "tables/")
+
+
+def sha256_of(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for block in iter(lambda: handle.read(1 << 20), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def excluded(rel: str) -> bool:
+    return any(rel.startswith(p) for p in EXCLUDE_PREFIXES)
+
+
+def selected(rel: str) -> bool:
+    if excluded(rel):
+        return False
+    tree = rel.split("/", 1)[0]
+    if rel in INCLUDE_FILES:
+        return True
+    if tree not in INCLUDE_TREES:
+        return False
+    suffixes = TREE_SUFFIX_FILTER.get(tree)
+    return suffixes is None or Path(rel).suffix in suffixes
+
+
+def source_files(source: Path) -> list[str]:
+    out = []
+    for p in sorted(source.rglob("*")):
+        if p.is_file():
+            out.append(p.relative_to(source).as_posix())
+    return out
+
+
+def git_export(rev: str, subdir: str, dest: Path) -> Path:
+    """Extract ``<rev>:<subdir>`` into ``dest`` and return the bundle root."""
+    archive = dest / "tree.tar"
+    with archive.open("wb") as fh:
+        subprocess.run(["git", "archive", rev, subdir], cwd=REPO_ROOT,
+                       stdout=fh, check=True)
+    with tarfile.open(archive) as tf:
+        tf.extractall(dest)
+    archive.unlink()
+    return dest / subdir
+
+
+def build(source: Path, target: Path, *, rev_note: str, check: bool) -> int:
+    files = source_files(source)
+    chosen = [r for r in files if selected(r)]
+    dropped = [r for r in files if not selected(r)]
+    if not chosen:
+        raise SystemExit(f"no evidence files found under {source}")
+
+    entries, problems = [], []
+    for rel in chosen:
+        src = source / rel
+        dst = target / rel
+        owner = REGENERATED.get(rel)
+        if owner:
+            # The evidence root owns this path; the historical bundle copy is
+            # superseded.  Hash what is on disk, and say who produced it.
+            if not dst.is_file():
+                problems.append(f"missing in evidence root (produced by {owner}): {rel}")
+                continue
+            entries.append({"path": rel, "sha256": sha256_of(dst),
+                            "bytes": dst.stat().st_size, "produced_by": owner})
+            continue
+        digest, size = sha256_of(src), src.stat().st_size
+        entries.append({"path": rel, "sha256": digest, "bytes": size})
+        if check:
+            if not dst.is_file():
+                problems.append(f"missing in evidence root: {rel}")
+            elif sha256_of(dst) != digest:
+                problems.append(f"sha256 differs from source: {rel}")
+            continue
+        dst.parent.mkdir(parents=True, exist_ok=True)
+        if not (dst.is_file() and dst.stat().st_size == size and sha256_of(dst) == digest):
+            shutil.copy2(src, dst)
+
+    excluded_block = {}
+    for rel in dropped:
+        if not excluded(rel):
+            continue  # filtered by suffix/tree, not an explicit exclusion
+        src = source / rel
+        excluded_block[rel] = {"sha256": sha256_of(src), "bytes": src.stat().st_size}
+
+    filtered = [r for r in dropped if not excluded(r)]
+
+    manifest = {
+        "schema": "paper1-evidence-manifest/1",
+        "description": (
+            "Manuscript-facing evidence export.  The experiment repository "
+            "remains the source of record for the runs; this tree is the "
+            "compact, versioned input that lets a clean manuscript checkout "
+            "rebuild every figure and re-read every claimed number."),
+        "source": rev_note,
+        "policy": {
+            "included_trees": list(INCLUDE_TREES),
+            "included_files": list(INCLUDE_FILES),
+            "figure_suffixes": list(TREE_SUFFIX_FILTER["figures"]),
+            "excluded_prefixes": list(EXCLUDE_PREFIXES),
+            "regenerated_paths": dict(REGENERATED),
+        },
+        "n_files": len(entries),
+        "total_bytes": sum(e["bytes"] for e in entries),
+        "files": sorted(entries, key=lambda e: e["path"]),
+        "excluded_retained_in_exp": excluded_block,
+        "filtered_by_policy": sorted(filtered),
+    }
+
+    if check:
+        listed = {e["path"] for e in entries}
+        for p in sorted(target.rglob("*")):
+            if not p.is_file():
+                continue
+            rel = p.relative_to(target).as_posix()
+            if rel in ("MANIFEST.json", "PROVENANCE.md", "README.md"):
+                continue
+            if rel not in listed:
+                problems.append(f"present in evidence root but not in source: {rel}")
+        for p in problems:
+            print(f"ERROR {p}")
+        print(f"[materialize --check] {len(entries)} files from {rev_note}: "
+              f"{'OK' if not problems else str(len(problems)) + ' problem(s)'}")
+        return 1 if problems else 0
+
+    target.mkdir(parents=True, exist_ok=True)
+    (target / "MANIFEST.json").write_text(
+        json.dumps(manifest, indent=2, sort_keys=False) + "\n", encoding="utf-8")
+    print(f"[materialize] {len(entries)} files ({manifest['total_bytes'] / 1e6:.1f} MB) "
+          f"-> {target}")
+    print(f"[materialize] {len(excluded_block)} path(s) explicitly excluded and hashed; "
+          f"{len(filtered)} filtered by tree/suffix policy")
+    return 0
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__,
+                                 formatter_class=argparse.RawDescriptionHelpFormatter)
+    src = ap.add_mutually_exclusive_group(required=True)
+    src.add_argument("--source", help="bundle directory (e.g. <EXP>/transfer_paper)")
+    src.add_argument("--from-git", dest="from_git",
+                     help="git revision of this repository carrying transfer_paper/")
+    ap.add_argument("--git-subdir", default="transfer_paper",
+                    help="subdirectory to take from --from-git (default transfer_paper)")
+    ap.add_argument("--check", action="store_true",
+                    help="verify the evidence root against the source; write nothing")
+    add_evidence_argument(ap)
+    args = ap.parse_args(argv)
+
+    target = evidence_root(args.evidence_root)
+    if args.source:
+        source = Path(args.source).expanduser().resolve()
+        if not source.is_dir():
+            raise SystemExit(f"source bundle not found: {source}")
+        return build(source, target, rev_note=f"directory:{source}", check=args.check)
+
+    with tempfile.TemporaryDirectory() as tmp:
+        source = git_export(args.from_git, args.git_subdir, Path(tmp))
+        rev = subprocess.run(["git", "rev-parse", args.from_git], cwd=REPO_ROOT,
+                             capture_output=True, text=True, check=True).stdout.strip()
+        return build(source, target, rev_note=f"git:{rev}:{args.git_subdir}",
+                     check=args.check)
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
